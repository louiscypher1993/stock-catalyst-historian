FROM batch_scanner_progress 
WHERE status = 'running';</sql><sql name="SQL 6*">SELECT COUNT(*), SUM(CASE WHEN is_null_sample = 0 THEN 1 ELSE 0 END) as events, 
SUM(CASE WHEN is_null_sample = 1 THEN 1 ELSE 0 END) as non_events
FROM event_features WHERE signal_snapshot_json IS NOT NULL;</sql><sql name="SQL 7*">
SELECT classification, COUNT(*) 
FROM event_features 
GROUP BY classification;
</sql><sql name="SQL 8*">PRAGMA table_info(event_features);
</sql><sql name="SQL 9*">SELECT * FROM event_features LIMIT 1;</sql><sql name="SQL 11*">UPDATE event_features
SET is_null_sample = 1
WHERE json_extract(gating_verdict_json, '$.event_classification') = 'SUPPRESSED_NON_EVENT';</sql><sql name="SQL 12*">SELECT 
  is_null_sample,
  COUNT(*) as count
FROM event_features
GROUP BY is_null_sample;</sql><sql name="SQL 13*">UPDATE batch_scanner_progress 
SET status = 'pending' 
WHERE status = 'error';
</sql><sql name="SQL 14*">UPDATE batch_scanner_progress 
SET status = 'pending' 
WHERE status = 'error';</sql><sql name="SQL 15*">SELECT status, COUNT(*) 
FROM batch_scanner_progress 
GROUP BY status;</sql><sql name="SQL 16*">SELECT * FROM batch_scanner_progress WHERE symbol = 'GAW.L';</sql><current_tab id="10"/></tab_sql></sqlb_project>
