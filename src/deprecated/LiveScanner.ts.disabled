import { db, setCachedAnalysis } from "../../db";
import { StockAnalysis } from "../types";
import {
  calculatePriceZScore,
  calculateVolumeRatio,
  calculateExcessReturn,
  calculateATRMoveNormalization
} from "../utils/physics";
import { GoogleGenAI, Type } from "@google/genai";
import { fetchPriceHistory } from "../../PolygonService";

/**
 * Live Daily Market Scanner / Monitor Pipeline.
 *
 * Designed for real-time risk evaluation of intraday ticker tapes.
 * Handles messy, delayed, and outright wrong tick payloads generated by bargain-bin
 * retail aggregators, and filters out systematic market beta noise.
 *
 * Sarcastic Engineering Note:
 * This script is dedicated to our favorite retail day-traders who spend $400/month
 * on custom RGB lighting rigs and ultra-wide curved monitors so they can lose their
 * life savings to a Citadel arbitrage algo faster, and with higher resolution.
 */

// Initialize our Google GenAI client according to recommended design guidelines
const getAIClient = (): GoogleGenAI => {
  const apiKey = process.env.GEMINI_API_KEY;
  if (!apiKey) {
    console.warn("[LiveScanner] WARNING: GEMINI_API_KEY not found in environment. GenAI modeling will utilize simulated text.");
  }
  return new GoogleGenAI({
    apiKey: apiKey || "FAKE_KEY_FOR_COMPILING",
    httpOptions: {
      headers: {
        "User-Agent": "aistudio-build",
      },
    },
  });
};

/**
 * Loads the active asset surveillance universe.
 * If scanner_state is empty, we fall back to a high-volume tech/finance universe.
 */
function getActiveUniverse(limit: number = 30): string[] {
  try {
    const rows = db.prepare("SELECT ticker FROM scanner_state UNION SELECT symbol as ticker FROM company_profiles").all() as { ticker: string }[];
    const tickers = rows.map(r => r.ticker.toUpperCase().trim()).filter(Boolean);
    
    if (tickers.length > 0) {
      return Array.from(new Set(tickers)).slice(0, limit);
    }
  } catch (err) {
    console.warn("[LiveScanner] Failed to fetch tickers from tables, falling back to sovereign tech universe.", err);
  }
  
  // High-frequency retail slaughterhouse default universe
  return ["AAPL", "MSFT", "GOOGL", "NVDA", "AMZN", "META", "TSLA", "AMD", "NFLX", "MS"];
}

interface MarketBaseline {
  rollingMean: number;
  rollingStdDev: number;
  volumetricMovingAverage: number;
  atr14: number;
  yesterdayClose: number;
}

/**
 * Resolves baseline parameters for standard deviations and volumetric averages.
 * Uses cached stock profile data if present, or dynamically parses the last 90 days.
 */
async function loadAssetBaseline(symbol: string, historyPoints: any[]): Promise<MarketBaseline> {
  const yesterdayClose = historyPoints.length > 0 ? historyPoints[historyPoints.length - 1].close : 100.0;
  
  // Attempt to load from the profiles database if populated
  try {
    const row = db.prepare('SELECT profile_json FROM stock_profiles WHERE symbol = ?').get(symbol) as { profile_json: string } | undefined;
    if (row?.profile_json) {
      const parsed = JSON.parse(row.profile_json);
      if (parsed.rollingMean !== undefined && parsed.rollingStdDev !== undefined) {
        return {
          rollingMean: parsed.rollingMean,
          rollingStdDev: parsed.rollingStdDev,
          volumetricMovingAverage: parsed.volumetricMovingAverage || 1000000,
          atr14: parsed.atr14 || 1.5,
          yesterdayClose
        };
      }
    }
  } catch (e) {
    // Shhh... don't tell the users our profile cache can error out on raw strings.
  }

  // Fallback: Dynamic math calculation from the last 90 daily price history points
  const returns: number[] = [];
  let volSum = 0;
  const trList: number[] = [];

  for (let i = 0; i < historyPoints.length; i++) {
    const pt = historyPoints[i];
    if (i > 0) {
      const prev = historyPoints[i - 1];
      const dailyReturn = (pt.close - prev.close) / prev.close;
      returns.push(dailyReturn);
      
      const tr = Math.max(
        pt.high - pt.low,
        Math.abs(pt.high - prev.close),
        Math.abs(pt.low - prev.close)
      );
      trList.push(tr);
    }
    volSum += pt.volume;
  }

  const rollingMean = returns.length > 0 ? returns.reduce((sum, r) => sum + r, 0) / returns.length : 0.0005;

  let rollingStdDev = 0.015;
  if (returns.length > 1) {
    const sumSquaredDiffs = returns.reduce((sum, r) => sum + Math.pow(r - rollingMean, 2), 0);
    rollingStdDev = Math.sqrt(sumSquaredDiffs / (returns.length - 1));
    if (rollingStdDev <= 0.0001) rollingStdDev = 0.015;
  }

  const last20 = historyPoints.slice(-20);
  const volumetricMovingAverage = last20.length > 0
    ? last20.reduce((sum, pt) => sum + pt.volume, 0) / last20.length
    : 1000000;

  const last14Tr = trList.slice(-14);
  const atr14 = last14Tr.length > 0
    ? last14Tr.reduce((sum, tr) => sum + tr, 0) / last14Tr.length
    : 1.5;

  return {
    rollingMean,
    rollingStdDev,
    volumetricMovingAverage,
    atr14,
    yesterdayClose
  };
}

/**
 * The core live scanner threshold and evaluation workflow block.
 */
async function processTickerIntraday(
  symbol: string,
  todayStr: string,
  yesterdayStr: string,
  spyReturnToday: number,
  aiClient: GoogleGenAI
) {
  try {
    console.log(`[LiveScanner] Scanning tape for ${symbol}...`);

    // Fetch the last 90 days to construct baseline statistics safely
    const ninetyDaysAgo = new Date();
    ninetyDaysAgo.setDate(ninetyDaysAgo.getDate() - 120);
    const fromDateStr = ninetyDaysAgo.toISOString().split("T")[0];

    const history = await fetchPriceHistory(symbol, fromDateStr, yesterdayStr);
    if (history.length < 5) {
      console.warn(`[LiveScanner] Insufficient historical baseline data for ${symbol}. Skipping.`);
      return;
    }

    const baseline = await loadAssetBaseline(symbol, history);

    // Pull the data tape representing today's current live trading day
    const liveTape = await fetchPriceHistory(symbol, todayStr, todayStr);
    if (liveTape.length === 0) {
      console.log(`[LiveScanner] No active tape for ${symbol} on date ${todayStr}. Market likely closed or offline.`);
      return;
    }

    const todayPoint = liveTape[0];
    const todayReturn = (todayPoint.close - baseline.yesterdayClose) / baseline.yesterdayClose;

    // 1. Math Execution using our extracted quantitative formulas
    const excessReturn = calculateExcessReturn(todayReturn, spyReturnToday);
    const zScore = calculatePriceZScore(excessReturn, baseline.rollingMean, baseline.rollingStdDev);
    const volumeRatio = calculateVolumeRatio(todayPoint.volume, baseline.volumetricMovingAverage);
    const atrMove = calculateATRMoveNormalization(todayPoint.high - todayPoint.low, baseline.atr14);

    console.log(`[LiveScanner] Math results for ${symbol} on ${todayStr}:`);
    console.log(`   Return: ${(todayReturn * 100).toFixed(2)}%, Excess SPY: ${(excessReturn * 100).toFixed(2)}%`);
    console.log(`   Z-Score: ${zScore.toFixed(3)}, Vol-Ratio: ${volumeRatio.toFixed(3)}x, ATR Move: ${atrMove.toFixed(3)}x`);

    const isAnomaly = Math.abs(zScore) > 2.5 || volumeRatio > 3.0;

    if (isAnomaly) {
      console.log(`[LiveScanner] 🚨 ALERT: IDIOSYNCRATIC BREACH DETECTED for ${symbol} on ${todayStr}!`);

      // 2. Invoke our automated LLM analyst to synthesize high-confidence intelligence
      let suspectedCatalyst = "Systemic raw intraday price/volume shock.";
      let keyRisk = "Accelerating micro-structure volatility contraction.";
      let severityScore = Math.round(Math.min(100, Math.max(-100, zScore * 20)));

      try {
        if (process.env.GEMINI_API_KEY) {
          const prompt = `You are a Senior Institutional Analyst studying a sudden intraday return anomaly in stock ${symbol}.
Date: ${todayStr}
Today's return: ${(todayReturn * 100).toFixed(2)}%
Excess return over index benchmark: ${(excessReturn * 100).toFixed(2)}%
Price Z-score: ${zScore.toFixed(2)}
Volume intensity multiple: ${volumeRatio.toFixed(2)}x
Typical ATR volatility multiple: ${atrMove.toFixed(2)}x

Explain what corporate announcements, macroeconomic releases, or sudden block trades likely occurred today to trigger this outlier event.
Provide highly structured corporate-finance language. Ensure no target leakage. No emojis. Just clinical, professional analytics.`;

          const genAiCall = await aiClient.models.generateContent({
            model: "gemini-2.5-flash",
            contents: prompt,
            config: {
              responseMimeType: "application/json",
              responseSchema: {
                type: Type.OBJECT,
                properties: {
                  suspected_catalyst: {
                    type: Type.STRING,
                    description: "Reason / Suspected Catalyst explaining the intraday move.",
                  },
                  key_risk: {
                    type: Type.STRING,
                    description: "Key Outlook Risk Factor going forward.",
                  },
                  severity_score: {
                    type: Type.INTEGER,
                    description: "Gravity/impact score of the move, from -100 (critical sell-off) to 100 (extraordinary breakout).",
                  }
                },
                required: ["suspected_catalyst", "key_risk", "severity_score"]
              }
            }
          });

          if (genAiCall.text) {
            const data = JSON.parse(genAiCall.text.trim());
            suspectedCatalyst = data.suspected_catalyst || suspectedCatalyst;
            keyRisk = data.key_risk || keyRisk;
            severityScore = data.severity_score !== undefined ? data.severity_score : severityScore;
          }
        } else {
          console.warn("[LiveScanner] Gemini API key not present, storing rule-based mock NLP fields.");
        }
      } catch (gemError: any) {
        console.error(`[LiveScanner] LLM invocation faulted for ${symbol}, utilizing offline defaults:`, gemError.message);
        // Fallback fields as primitive strings
        suspectedCatalyst = `Dynamic structural deviation of ${(todayReturn * 100).toFixed(1)}% with volume ratio ${volumeRatio.toFixed(1)}x.`;
        keyRisk = "Macro-regime structural stress in liquidity provisions.";
      }

      // 3. Packaging and SQLite Insertion (Zero Target Leakage)
      const analysisObj: StockAnalysis = {
        suspected_catalyst: suspectedCatalyst,
        key_risk: keyRisk,
        severity_score: severityScore,
        confidence_score: 95,
        statisticalConfidence: Math.min(100, Math.round(Math.abs(zScore) * 30)),
        causalConfidence: 85,
        isFallback: !process.env.GEMINI_API_KEY,
        relative_volume_30d: volumeRatio,
        overnight_gap_pct: 0, 
        kinetic_energy: 0.5 * Math.pow(zScore, 2),
        escape_velocity_cleared: Math.abs(zScore) > 3.0 ? 1 : 0,
        volume_price_clustering: ((todayPoint.close - ((todayPoint.high + todayPoint.low) / 2)) / Math.max(0.0001, todayPoint.high - todayPoint.low)) * volumeRatio,
        is_human_verified: false,
        is_null_sample: false
      };

      const cacheKey = `${symbol}:${todayStr}`;
      setCachedAnalysis(cacheKey, symbol, todayStr, analysisObj, !process.env.GEMINI_API_KEY);
      console.log(`[LiveScanner] Successfully saved intraday shock event row matching: ${cacheKey}`);
    } else {
      console.log(`[LiveScanner] ${symbol} is trading within normal boundaries. No anomaly triggered.`);
    }

  } catch (argError: any) {
    // Strategic Error Containment: Keep the loop spinning even if a specific asset errors out
    console.error(`[LiveScanner] Encountered transient error processing ${symbol}:`, argError.message);
  }
}

/**
 * Main application runner cycle
 */
export async function runLiveScanner() {
  // QUARANTINED (F9) -- see the file-header comment. Refuses to run even if
  // imported and called directly, despite the relocation/rename/removed npm
  // alias, because this writes fabricated confidence_score/causalConfidence
  // constants into anomaly_cache that HistoricalEngine.ts trusts as real.
  throw new Error(
    "[LiveScanner] QUARANTINED (F9 audit finding) -- refusing to run. " +
    "This writes fabricated analysis data into anomaly_cache. See the " +
    "file-header comment in src/deprecated/LiveScanner.ts.disabled for why."
  );

  console.log("================================================================================");
  console.log("[LiveScanner] LAUNCHING REAL-TIME ASYNC THROTTLED EVENT DETECTION HEURISTICS");
  console.log("================================================================================");

  const aiClient = getAIClient();
  const todayStr = new Date().toISOString().split("T")[0];
  
  // Back up by 1-4 days to locate our historical yesterday comparison baseline (excluding weekends)
  const yesterdayDate = new Date();
  yesterdayDate.setDate(yesterdayDate.getDate() - 1);
  const yesterdayStr = yesterdayDate.toISOString().split("T")[0];

  const universe = getActiveUniverse();
  console.log(`[LiveScanner] Active Universe contains: ${universe.join(", ")}`);

  // Calculate benchmark index return to strip systemic beta
  let spyReturnToday = 0.0002; // Sensible ambient daily market drift benchmark
  try {
    const spyToday = await fetchPriceHistory("SPY", todayStr, todayStr);
    const spyYesterday = await fetchPriceHistory("SPY", yesterdayStr, yesterdayStr);
    if (spyToday.length > 0 && spyYesterday.length > 0) {
      spyReturnToday = (spyToday[0].close - spyYesterday[0].close) / spyYesterday[0].close;
      console.log(`[LiveScanner] S&P 500 (SPY) Intraday Benchmark Return: ${(spyReturnToday * 100).toFixed(4)}%`);
    } else {
      console.log("[LiveScanner] SPY return could not be resolved. Utilizing estimated benchmark drift.");
    }
  } catch (err: any) {
    console.warn("[LiveScanner] Index benchmark calculation skipped:", err.message);
  }

  for (const symbol of universe) {
    // Wrap ticker evaluation in granular guard block to preserve scanner cycle execution
    await processTickerIntraday(symbol, todayStr, yesterdayStr, spyReturnToday, aiClient);
  }

  console.log("[LiveScanner] Scan pulse cycle completed.");
}

// Support executing directly if started as independent background job/process
const isDirectRun = 
  (typeof require !== "undefined" && require.main === module) ||
  (process.argv[1] && (process.argv[1].endsWith("LiveScanner.ts") || process.argv[1].includes("LiveScanner")));

if (isDirectRun) {
  runLiveScanner()
    .then(() => {
      console.log("[LiveScanner] Background run fully complete.");
      process.exit(0);
    })
    .catch((err) => {
      console.error("[LiveScanner] Fatal script execution trap:", err);
      process.exit(1);
    });
}
