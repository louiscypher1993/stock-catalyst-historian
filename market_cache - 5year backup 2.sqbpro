<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="market_cache - 5year backup.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="3169"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="anomaly_cache" custom_title="0" dock_id="1" table="4,13:mainanomaly_cache"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011e00ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">-- See if the old 5-year data for those symbols was wiped but not replaced
SELECT symbol, COUNT(*) 
FROM event_features 
GROUP BY symbol;</sql><sql name="SQL 2*">SELECT symbol, COUNT(*) 
FROM event_features 
WHERE symbol IN (
  SELECT symbol FROM batch_scanner_progress WHERE status = 'completed'
)
GROUP BY symbol
ORDER BY COUNT(*) DESC;</sql><sql name="SQL 3*">SELECT symbol, status, scanned_at 
FROM batch_scanner_progress 
WHERE status = 'completed' 
ORDER BY scanned_at DESC 
LIMIT 10;</sql><sql name="SQL 4*">SELECT symbol, error_message 
FROM batch_scanner_progress 
WHERE status = 'error';</sql><sql name="SQL 5*">SELECT symbol, status, scanned_at, events_found
FROM batch_scanner_progress 
WHERE status = 'completed' 
LIMIT 10;</sql><sql name="SQL 6*">SELECT COUNT(*) 
FROM batch_scanner_progress 
WHERE status = 'completed' AND events_found IS NULL;</sql><sql name="SQL 7*">SELECT symbol, events_found, scanned_at
FROM batch_scanner_progress

ORDER BY scanned_at DESC
</sql><current_tab id="6"/></tab_sql></sqlb_project>
