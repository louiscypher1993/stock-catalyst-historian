# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FMP_API_KEY: Required for Financial Modeling Prep API calls.
FMP_API_KEY=
FMP_DAILY_BUDGET=250        # 250 free, 1000000 premium
FMP_TIER=free               # 'free' or 'premium'

# EODHD_API_KEY: Required for EODHD Historical Data API calls.
EODHD_API_KEY=

# POLYGON_API_KEY: Required for Polygon.io API calls.
POLYGON_API_KEY=

# NEWSAPI_KEY: Required for NewsAPI calls.
NEWSAPI_KEY=

# FRED_API_KEY: Required for Federal Reserve Economic Data calls.
FRED_API_KEY=

# REDDIT_CLIENT_ID: Client ID for reddit API
REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET: Client Secret for reddit API
REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT: Custom user agent for reddit API requests
REDDIT_USER_AGENT=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Required for YouTube Data API v3 calls.
YOUTUBE_API_KEY=
