SELECT status, COUNT(*) 
FROM batch_scanner_progress 
GROUP BY status;</sql><sql name="SQL 2">SELECT COUNT(*) FROM event_features;</sql><sql name="SQL 3*">SELECT symbol, COUNT(*) as events
FROM event_features
GROUP BY symbol

</sql><sql name="SQL 4">SELECT 
  COUNT(*) as total_rows,
  SUM(CASE WHEN is_null_sample = 0 OR is_null_sample IS NULL THEN 1 ELSE 0 END) as events,
  SUM(CASE WHEN is_null_sample = 1 THEN 1 ELSE 0 END) as non_events
FROM event_features;</sql><sql name="SQL 5">SELECT
  COUNT(*) as total_rows,
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.fmp_news_sentiment_avg') IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as fmp_news_pct,
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.price_target_consensus') IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as price_target_pct,
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.gdelt_tone_z') IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as gdelt_pct,
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.insider_net_shares_30d') IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as insider_pct,
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.eps_surprise_pct') IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as eps_surprise_pct,
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.analyst_upgrades_30d') IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as analyst_grades_pct,
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.stocktwits_virality_z') IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as stocktwits_pct,
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.snap_short_interest_pct_float') IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as short_interest_pct
FROM event_features;</sql><sql name="SQL 6">SELECT
  CASE WHEN is_null_sample = 1 THEN 'non_event' ELSE 'event' END as row_type,
  COUNT(*) as total,
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.fmp_news_sentiment_avg') IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as fmp_news_pct,
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.price_target_consensus') IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as price_target_pct,
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.gdelt_tone_z') IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as gdelt_pct,
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.insider_net_shares_30d') IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as insider_pct,
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.eps_surprise_pct') IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as eps_surprise_pct,
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.analyst_upgrades_30d') IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as analyst_grades_pct,
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.stocktwits_virality_z') IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as stocktwits_pct,
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.snap_short_interest_pct_float') IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as short_interest_pct
FROM event_features
GROUP BY row_type;</sql><sql name="SQL 7*">SELECT status, COUNT(*) FROM batch_scanner_progress GROUP BY status;
SELECT * FROM batch_scanner_progress WHERE status = 'IN_PROGRESS';</sql><sql name="SQL 8*">SELECT 
  COUNT(*) as completed,
  (SELECT COUNT(*) FROM batch_scanner_progress) as total,
  (SELECT COUNT(*) FROM batch_scanner_progress WHERE status = 'error') as errors
FROM batch_scanner_progress WHERE status = 'complete';</sql><sql name="SQL 9*">SELECT 
  status,
  COUNT(*) as count,
  SUM(events_found) as total_events
FROM batch_scanner_progress 
GROUP BY status;

SELECT COUNT(*) as total_rows FROM event_features;</sql><sql name="SQL 10*">SELECT status, COUNT(*) 
FROM batch_scanner_progress 
GROUP BY status;</sql><sql name="SQL 11*">SELECT events_found, status, scanned_at 
FROM batch_scanner_progress 

ORDER BY scanned_at DESC 

</sql><current_tab id="10"/></tab_sql></sqlb_project>
