<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="market_cache.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="3169"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="anomaly_cache" custom_title="0" dock_id="4" table="4,13:mainanomaly_cache"/><dock_state state="000000ff00000000fd00000001000000020000024800000213fc0100000002fb000000160064006f0063006b00420072006f00770073006500310100000000000002480000000000000000fb000000160064006f0063006b00420072006f00770073006500340100000000000002480000016200ffffff000002480000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="anomaly_cache" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="47"/><column index="2" value="127"/><column index="3" value="49"/><column index="4" value="87"/><column index="5" value="300"/><column index="6" value="68"/><column index="7" value="199"/><column index="8" value="181"/><column index="9" value="173"/><column index="10" value="133"/><column index="11" value="124"/><column index="12" value="136"/><column index="13" value="92"/><column index="14" value="113"/><column index="15" value="124"/><column index="16" value="99"/><column index="17" value="115"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 2">SELECT classification, COUNT(*) 
FROM event_features 
GROUP BY classification;
</sql><sql name="SQL 3">SELECT COUNT(*), SUM(CASE WHEN is_null_sample = 0 THEN 1 ELSE 0 END) as events, 
SUM(CASE WHEN is_null_sample = 1 THEN 1 ELSE 0 END) as non_events
FROM event_features WHERE signal_snapshot_json IS NOT NULL;</sql><sql name="SQL 4">SELECT status, COUNT(*) 
FROM batch_scanner_progress 
GROUP BY status;</sql><sql name="SQL 5">SELECT symbol, status, scanned_at 
FROM batch_scanner_progress 
ORDER BY scanned_at;</sql><sql name="SQL 5">UPDATE event_features SET is_null_sample = 1
WHERE json_extract(gating_verdict_json, '$.event_classification') = 'SUPPRESSED_NON_EVENT'
AND is_null_sample = 0;</sql><sql name="SQL 6">UPDATE batch_scanner_progress SET status = 'pending';</sql><sql name="SQL 7">SELECT symbol, date, is_null_sample, signal_snapshot_json
FROM event_features
WHERE is_null_sample = 0
AND signal_snapshot_json IS NOT NULL
ORDER BY RANDOM()
LIMIT 1;</sql><sql name="SQL 8">SELECT symbol, date, is_null_sample, signal_snapshot_json
FROM event_features
WHERE is_null_sample = 1
AND signal_snapshot_json IS NOT NULL
ORDER BY RANDOM()
LIMIT 1;</sql><sql name="SQL 9">SELECT 
  COUNT(*) as total,
  SUM(CASE WHEN is_null_sample = 0 THEN 1 ELSE 0 END) as events,
  SUM(CASE WHEN is_null_sample = 1 THEN 1 ELSE 0 END) as non_events,
  SUM(CASE WHEN json_extract(signal_snapshot_json, '$.gdelt_conflict_index') IS NOT NULL THEN 1 ELSE 0 END) as has_gdelt,
  SUM(CASE WHEN json_extract(signal_snapshot_json, '$.stocktwits_virality_z') IS NOT NULL THEN 1 ELSE 0 END) as has_stocktwits,
  SUM(CASE WHEN json_extract(signal_snapshot_json, '$.forward_return_5d') IS NOT NULL THEN 1 ELSE 0 END) as has_forward_returns
FROM event_features
WHERE signal_snapshot_json IS NOT NULL;</sql><sql name="SQL 10">SELECT 
  COUNT(*) as total,
  SUM(CASE WHEN forward_return_5d IS NOT NULL THEN 1 ELSE 0 END) as has_5d,
  SUM(CASE WHEN forward_return_10d IS NOT NULL THEN 1 ELSE 0 END) as has_10d,
  SUM(CASE WHEN forward_return_20d IS NOT NULL THEN 1 ELSE 0 END) as has_20d
FROM event_features;</sql><sql name="SQL 11">PRAGMA table_info(event_features);</sql><sql name="SQL 13">SELECT symbol, date, features_json
FROM event_features
WHERE is_null_sample = 0
LIMIT 1;</sql><sql name="SQL 14">SELECT 
  json_extract(signal_snapshot_json, '$.forward_return_5d') as fwd_5d,
  json_extract(signal_snapshot_json, '$.forward_return_10d') as fwd_10d,
  json_extract(features_json, '$.forward_return_5d') as feat_fwd_5d,
  json_extract(features_json, '$.return_5d') as feat_return_5d
FROM event_features
WHERE is_null_sample = 0
LIMIT 5;</sql><sql name="SQL 15">SELECT 
  symbol,
  date,
  json_extract(features_json, '$.forward_return_1d') as fwd_1d,
  json_extract(features_json, '$.forward_return_1w') as fwd_1w,
  json_extract(features_json, '$.forward_return_1m') as fwd_1m
FROM event_features
WHERE is_null_sample = 0
AND json_extract(features_json, '$.forward_return_1d') IS NOT NULL
LIMIT 10;</sql><sql name="SQL 16">SELECT
  COUNT(*) as total,
  SUM(CASE WHEN json_extract(features_json, '$.forward_return_1d') IS NOT NULL THEN 1 ELSE 0 END) as has_fwd_1d,
  SUM(CASE WHEN json_extract(features_json, '$.forward_return_1w') IS NOT NULL THEN 1 ELSE 0 END) as has_fwd_1w,
  SUM(CASE WHEN json_extract(features_json, '$.forward_return_1m') IS NOT NULL THEN 1 ELSE 0 END) as has_fwd_1m
FROM event_features
WHERE is_null_sample = 0;</sql><sql name="SQL 17">SELECT 
  json_extract(features_json, '$.gdelt_tone_z') as feat_gdelt,
  json_extract(features_json, '$.gdelt_conflict_index') as feat_gdelt_conflict,
  json_extract(signal_snapshot_json, '$.gdelt_tone_z') as snap_gdelt
FROM event_features
WHERE is_null_sample = 0
LIMIT 5;</sql><sql name="SQL 17">Copy-Item &quot;market_cache.db&quot; &quot;market_cache_5yr_backup.db&quot;
</sql><sql name="SQL 18">SELECT status, COUNT(*) 
FROM batch_scanner_progress 
GROUP BY status;</sql><sql name="SQL 19">SELECT symbol, MIN(date), MAX(date), COUNT(*) as anomalies
FROM event_features
WHERE symbol = 'AA'
GROUP BY symbol;</sql><sql name="SQL 20">DELETE FROM scanner_state;</sql><sql name="SQL 23">UPDATE batch_scanner_progress SET status = 'pending';</sql><sql name="SQL 22*">SELECT symbol, MIN(date), MAX(date), COUNT(*) as anomalies
FROM event_features
WHERE symbol = 'AA'
GROUP BY symbol;</sql><current_tab id="21"/></tab_sql></sqlb_project>
