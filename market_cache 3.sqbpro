<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="market_cache.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="3169"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="anomaly_cache" custom_title="0" dock_id="1" table="4,13:mainanomaly_cache"/><dock_state state="000000ff00000000fd00000001000000020000024600000213fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000002460000016200ffffff000002460000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="anomaly_cache" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="55"/><column index="2" value="167"/><column index="3" value="79"/><column index="4" value="87"/><column index="5" value="300"/><column index="6" value="68"/><column index="7" value="199"/><column index="8" value="181"/><column index="9" value="173"/><column index="10" value="133"/><column index="11" value="124"/><column index="12" value="136"/><column index="13" value="92"/><column index="14" value="113"/><column index="15" value="124"/><column index="16" value="99"/><column index="17" value="115"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">SELECT symbol, events_found, error_message 
FROM batch_scanner_progress 
WHERE status = 'pending'
LIMIT 30;</sql><sql name="SQL 2">SELECT 
  COUNT(*) as total_rows,
  SUM(CASE WHEN is_null_sample = 0 THEN 1 ELSE 0 END) as events,
  SUM(CASE WHEN is_null_sample = 1 THEN 1 ELSE 0 END) as non_events,
  COUNT(DISTINCT symbol) as symbols
FROM event_features;</sql><sql name="SQL 3*">SELECT COUNT(*) as total,
  SUM(CASE WHEN json_extract(signal_snapshot_json, '$.fmp_social_sentiment_score') IS NOT NULL THEN 1 ELSE 0 END) as has_social,
  SUM(CASE WHEN json_extract(signal_snapshot_json, '$.insider_net_shares_30d') IS NOT NULL THEN 1 ELSE 0 END) as has_insider
FROM event_features;</sql><sql name="SQL 4*">SELECT COUNT(*) as total,
  SUM(CASE WHEN json_extract(signal_snapshot_json, '$.fmp_social_sentiment_score') IS NOT NULL THEN 1 ELSE 0 END) as has_social,
  SUM(CASE WHEN json_extract(signal_snapshot_json, '$.insider_net_shares_30d') IS NOT NULL THEN 1 ELSE 0 END) as has_insider,
  SUM(CASE WHEN json_extract(signal_snapshot_json, '$.eps_surprise_pct') IS NOT NULL THEN 1 ELSE 0 END) as has_earnings,
  SUM(CASE WHEN json_extract(signal_snapshot_json, '$.institutional_ownership_pct') IS NOT NULL THEN 1 ELSE 0 END) as has_institutional
FROM event_features;</sql><sql name="SQL 5*">SELECT COUNT(*) as total,
  SUM(CASE WHEN is_null_sample = 1 THEN 1 ELSE 0 END) as null_samples,
  SUM(CASE WHEN is_null_sample = 0 OR is_null_sample IS NULL THEN 1 ELSE 0 END) as real_events
FROM event_features;</sql><sql name="SQL 6*">SELECT COUNT(*) as total,
  SUM(CASE WHEN json_extract(signal_snapshot_json, '$.fmp_news_sentiment_avg') IS NOT NULL THEN 1 ELSE 0 END) as has_news,
  SUM(CASE WHEN json_extract(signal_snapshot_json, '$.insider_net_shares_30d') IS NOT NULL THEN 1 ELSE 0 END) as has_insider,
  SUM(CASE WHEN json_extract(signal_snapshot_json, '$.eps_surprise_pct') IS NOT NULL THEN 1 ELSE 0 END) as has_earnings
FROM event_features;</sql><sql name="SQL 7*">SELECT signal_snapshot_json 
FROM event_features 
WHERE signal_snapshot_json LIKE '%eps%' 
</sql><sql name="SQL 8*">SELECT signal_snapshot_json 
FROM event_features 
WHERE signal_snapshot_json IS NOT NULL 
LIMIT 1;</sql><sql name="SQL 10*">SELECT 
  -- Core signals (from top-level columns)
  ROUND(100.0 * SUM(CASE WHEN confidence_tier IS NOT NULL THEN 1 END) / COUNT(*), 1) AS confidence_tier_pct,

  -- Signals from signal_snapshot JSON
  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.fmp_news_sentiment_avg') IS NOT NULL THEN 1 END) / COUNT(*), 1) AS news_sentiment_pct,

  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.short_interest_pct_float') IS NOT NULL THEN 1 END) / COUNT(*), 1) AS short_interest_pct,

  ROUND(100.0 * SUM(CASE WHEN json_extract(signal_snapshot_json, '$.estimate_revision_direction') IS NOT NULL THEN 1 END) / COUNT(*), 1) AS estimate_revision_pct,

  -- Insider (stored in features_json)
  ROUND(100.0 * SUM(CASE WHEN json_extract(features_json, '$.insider_net_shares_30d') IS NOT NULL THEN 1 END) / COUNT(*), 1) AS insider_pct,

  -- Earnings surprise (missing — confirming zero)
  ROUND(100.0 * SUM(CASE WHEN json_extract(features_json, '$.eps_surprise_pct') IS NOT NULL THEN 1 END) / COUNT(*), 1) AS eps_surprise_pct,
  ROUND(100.0 * SUM(CASE WHEN json_extract(features_json, '$.revenue_surprise_pct') IS NOT NULL THEN 1 END) / COUNT(*), 1) AS revenue_surprise_pct,

  -- Analyst grades (confirming zero bug)
  ROUND(100.0 * SUM(CASE WHEN json_extract(features_json, '$.analyst_upgrades_30d') IS NOT NULL THEN 1 END) / COUNT(*), 1) AS analyst_upgrades_pct,
  ROUND(100.0 * SUM(CASE WHEN json_extract(features_json, '$.analyst_downgrades_30d') IS NOT NULL THEN 1 END) / COUNT(*), 1) AS analyst_downgrades_pct,

  COUNT(*) AS total_rows
FROM event_features;</sql><current_tab id="8"/></tab_sql></sqlb_project>
