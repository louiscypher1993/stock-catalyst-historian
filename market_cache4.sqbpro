FROM batch_scanner_progress 
GROUP BY status;</sql><sql name="SQL 2">SELECT symbol, status, scanned_at 
FROM batch_scanner_progress 
WHERE status != 'complete' 
ORDER BY scanned_at DESC 
LIMIT 20;</sql><sql name="SQL 3">SELECT symbol FROM batch_scanner_progress 
WHERE status = 'pending' 
LIMIT 20;</sql><sql name="SQL 4*">SELECT symbol, status, scanned_at 
FROM batch_scanner_progress 
ORDER BY scanned_at DESC 
</sql><current_tab id="3"/></tab_sql></sqlb_project>
